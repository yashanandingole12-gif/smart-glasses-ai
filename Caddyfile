# ==============================================================================
# EVA Caddy Proxy Configuration — Automated Let's Encrypt SSL & WebSocket Proxy
# Replace :80 with your domain (e.g. eva.yourdomain.com) for auto HTTPS
# ==============================================================================

:80 {
    reverse_proxy eva-backend:8000 {
        header_up Host {host}
        header_up X-Real-IP {remote_host}
        header_up X-Forwarded-For {remote_host}
        header_up X-Forwarded-Proto {scheme}
    }
}
