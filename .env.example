# =============================================================================
# EVA — Unified AI Companion Environment Configuration
# =============================================================================
# Copy this file to .env and populate the variables with your credentials.
# NEVER commit the real .env file or real secrets to source control.
# =============================================================================

# =========================
# 1. LLM PROVIDERS
# =========================
# Primary/Fast model (Google Gemini recommended for low-latency voice)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-lite-latest

# Secondary/Alternative LLM providers
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-latest
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_BASE_URL=https://api.deepseek.com

# Routing tier selections: "gemini", "deepseek", "openai", "anthropic", "mock"
FAST_LLM_PROVIDER=gemini
PRIMARY_LLM_PROVIDER=gemini
SECONDARY_LLM_PROVIDER=deepseek
FALLBACK_LLM_PROVIDER=mock

# =========================
# 2. GOOGLE WORKSPACE & OAUTH 2.0
# =========================
# Google Cloud Console OAuth 2.0 Client Credentials for Gmail, Calendar, Drive, Contacts
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8001/api/v1/auth/google/callback

# =========================
# 3. GITHUB INTEGRATION
# =========================
# Personal Access Token with repo/read:user permissions or GitHub App credentials
GITHUB_TOKEN=
GITHUB_APP_ID=
GITHUB_PRIVATE_KEY=

# =========================
# 4. LINKEDIN INTEGRATION
# =========================
# Official LinkedIn Developer Application OAuth 2.0 credentials
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URI=http://localhost:8001/api/v1/auth/linkedin/callback
LINKEDIN_ACCESS_TOKEN=

# =========================
# 5. ACADEMIC RESEARCH PROVIDERS
# =========================
# arXiv is open-access and enabled by default (no API key required)
ARXIV_ENABLED=true

# OpenAlex (Optional API key for higher rate limits, polite pool email)
OPENALEX_API_KEY=
OPENALEX_EMAIL=

# Semantic Scholar (Optional API key for higher rate limits)
SEMANTIC_SCHOLAR_API_KEY=

# Crossref (Polite pool email for DOI metadata queries)
CROSSREF_EMAIL=

# =========================
# 6. WEB SEARCH PROVIDERS
# =========================
# Tavily or SerpApi for real-time live web searches
WEB_SEARCH_API_KEY=
WEB_SEARCH_ENGINE=tavily
WEB_SEARCH_BASE_URL=

# =========================
# 7. OPPORTUNITY & JOB PROVIDERS
# =========================
LINKEDIN_OPPORTUNITY_ENABLED=true
INTERNSHALA_ENABLED=false
INDEED_ENABLED=false
OTHER_JOB_PROVIDER_ENABLED=false

# =========================
# 8. HARDWARE & WIFI PROVISIONING
# =========================
GLASSES_WIFI_SSID=EVA 3693
GLASSES_WIFI_PASSWORD=

# =========================
# 9. SERVER & RUNTIME SETTINGS
# =========================
HOST=127.0.0.1
PORT=8001
DEBUG=true
LOG_LEVEL=INFO
DATABASE_URL=sqlite:///./smart_glasses.db
STT_ENGINE=faster_whisper
TTS_ENGINE=sapi5
