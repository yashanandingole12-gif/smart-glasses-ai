# ==============================================================================
# Context-Aware Smart Glasses AI Assistant - Environment Configuration
# ==============================================================================

# LLM Provider Configuration
# Supported providers: "mock", "openai", "gemini", "anthropic", "ollama"
LLM_PROVIDER=gemini
LLM_MODEL=gemini-2.5-flash
LLM_API_KEY=
LLM_BASE_URL=

# Backend Server Configuration
HOST=127.0.0.1
PORT=8001
DEBUG=true
LOG_LEVEL=INFO

# Default / Fallback Context
DEFAULT_LOCATION_CITY=Nagpur
DEFAULT_LOCATION_COUNTRY=India
DEFAULT_LOCATION_LATITUDE=21.1458
DEFAULT_LOCATION_LONGITUDE=79.0882
DEFAULT_TIMEZONE=Asia/Kolkata

# Database / Memory
DATABASE_URL=sqlite:///./smart_glasses.db

# Simulator Settings
SIMULATOR_BACKEND_URL=http://127.0.0.1:8001
SIMULATOR_AUDIO_SAMPLE_RATE=16000
SIMULATOR_SPEECH_RECOGNITION_BACKEND=local
SIMULATOR_TTS_BACKEND=sapi5

# Google OAuth 2.0 (Gmail & Google Calendar)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8001/api/v1/auth/google/callback

# Search Integrations (Optional)
TAVILY_API_KEY=
SERPAPI_API_KEY=
