# ==============================================================================
# Context-Aware Smart Glasses AI Assistant - Environment Configuration
# ==============================================================================

# LLM Provider Configuration
# Supported providers: "mock", "openai", "gemini", "anthropic", "ollama"
LLM_PROVIDER=mock
LLM_MODEL=gemini-2.0-flash
LLM_API_KEY=
LLM_BASE_URL=

# Backend Server Configuration
HOST=127.0.0.1
PORT=8000
DEBUG=true
LOG_LEVEL=INFO

# Default / Fallback Context
DEFAULT_LOCATION_CITY=Nagpur
DEFAULT_LOCATION_COUNTRY=India
DEFAULT_LOCATION_LATITUDE=21.1458
DEFAULT_LOCATION_LONGITUDE=79.0882
DEFAULT_TIMEZONE=Asia/Kolkata

# Database / Memory
DATABASE_URL=sqlite:///./smart_glasses.db

# Simulator Settings
SIMULATOR_BACKEND_URL=http://127.0.0.1:8000
SIMULATOR_AUDIO_SAMPLE_RATE=16000
SIMULATOR_SPEECH_RECOGNITION_BACKEND=local
SIMULATOR_TTS_BACKEND=sapi5

# External Integrations (Optional / Future Phases)
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=
TAVILY_API_KEY=
SERPAPI_API_KEY=
